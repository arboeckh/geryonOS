<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-feature android:name="android.hardware.nfc" android:required="true" />

    <application
        android:name=".GeryonApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Geryon">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Tapping a tag written by geryon (geryon://tag/<id>) launches the app,
                 even when it is closed, as long as the phone is unlocked. -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="geryon" android:host="tag" />
            </intent-filter>
        </activity>

        <service
            android:name=".enforce.AppBlockerService"
            android:exported="true"
            android:label="@string/app_blocker_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/app_blocker" />
        </service>

        <!-- Invisible: asks for VPN consent and starts the DNS VPN. -->
        <activity
            android:name=".enforce.dns.VpnSetupActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="false"
            android:taskAffinity="io.github.arboeckh.geryon.vpnsetup"
            android:theme="@style/Theme.Geryon.Translucent" />

        <!-- Local DNS-only VPN that answers blocked domains itself. -->
        <service
            android:name=".enforce.dns.DnsVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local DNS filter (VpnService) that blocks domains the user chose; no traffic leaves the device through it." />
        </service>
    </application>
</manifest>
